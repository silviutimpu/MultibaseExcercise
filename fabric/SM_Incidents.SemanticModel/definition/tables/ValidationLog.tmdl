table ValidationLog
	lineageTag: 0d982504-451d-4929-ab17-e9fff078dfc2
	sourceLineageTag: [audit].[ValidationLog]

	measure '# Reguli picate' =
			
			CALCULATE( COUNTROWS( ValidationLog ), ValidationLog[Passed] = FALSE() )
		formatString: 0
		lineageTag: 2c447891-29f1-4d82-b673-312073afba12

		changedProperty = Name

	measure '# Reguli picate (ultima rulare)' =
			
			VAR ultima = MAX( ValidationLog[RunTimestamp] )
			RETURN
			    CALCULATE(
			        COUNTROWS( ValidationLog ),
			        ValidationLog[Passed] = FALSE(),
			        ValidationLog[RunTimestamp] = ultima
			    )
		formatString: 0
		lineageTag: 0dda241a-6d4d-4c79-85bc-f2d86689e978

		changedProperty = Name

